# Copy to .env and set ONE provider. With several keys present, the order is
# Anthropic > Gemini > OpenAI, unless WORKER_PROVIDER says otherwise.
# Check your setup with:  python -m worker check   (one tiny request)

# --- Option A: Google Gemini free tier (no card; key from https://aistudio.google.com) ---
GEMINI_API_KEY=

# --- Option B: Anthropic Claude (paid; best quality) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_EFFORT=high            # low | medium | high | xhigh | max (lower = cheaper)

# --- Option C: OpenAI (paid) ---
# OPENAI_API_KEY=

# --- Option D: any OpenAI-compatible server (Ollama, OpenRouter, Groq, vLLM) ---
# WORKER_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:14b
# LLM_API_KEY=                     # not needed for local Ollama

# --- Common overrides ---
# WORKER_PROVIDER=gemini           # anthropic | gemini | openai | openai_compatible
# LLM_MODEL=gemini-3.1-flash-lite  # override the provider's default model
# LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash   # tried in order when a daily quota runs out ("" = never switch)
# LLM_RPM=8                        # requests/minute cap (Gemini free tier default: 8; 0 = none)
# LLM_REASONING_EFFORT=low         # for OpenAI-protocol reasoning models
# WORKER_APPROVAL_MODE=risky       # risky | always | never
# WORKER_PLAN_REVIEW=0             # 1 = approve the worker's plan before it acts
# WORKER_HEADLESS=0                # 0 = show the browser window
# WORKER_BROWSER_CHANNEL=chrome    # use installed Chrome/Edge instead of bundled Chromium
