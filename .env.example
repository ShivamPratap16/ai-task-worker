# Copy to .env and fill in ONE provider key. Claude is used when its key is present.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional overrides
# WORKER_PROVIDER=anthropic          # or openai; default = auto-detect
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=high
# OPENAI_MODEL=gpt-5.4
# OPENAI_REASONING_EFFORT=low
# WORKER_APPROVAL_MODE=risky         # risky | always | never
# WORKER_HEADLESS=0                  # 0 = show the browser window
# WORKER_BROWSER_CHANNEL=chrome      # use installed Chrome/Edge instead of bundled Chromium
